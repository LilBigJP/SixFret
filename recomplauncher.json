{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Six Fret",
  "repo": "LilBigJP/SixFret",
  "inputs": [
    {
      "id": "game",
      "label": "Your Guitar Hero Live for PS4 (CUSA02410): the dumped game folder with eboot.bin, sce_module and sce_sys (updated to version 1.08), or the game's fake-signed PKG.",
      "role": "game",
      "formats": [
        {
          "type": "folder"
        },
        {
          "type": "file",
          "extensions": [
            "pkg"
          ]
        }
      ],
      "check": {
        "ids": [
          "CUSA02410",
          "CUSA02188"
        ]
      }
    },
    {
      "id": "update",
      "label": "The version 1.08 update PKG, when your game is a PKG (a dumped folder has it already).",
      "role": "update",
      "optional": true,
      "formats": [
        {
          "type": "file",
          "extensions": [
            "pkg"
          ]
        }
      ]
    }
  ],
  "start": {
    "program": [
      "SixFret.exe",
      "sixfret-x86_64.AppImage"
    ],
    "args": [
      "--play",
      "--game={input:game}",
      "--update={input:update}"
    ]
  },
  "prepare": {
    "program": [
      "SixFret.exe",
      "sixfret-x86_64.AppImage"
    ],
    "args": [
      "--prepare",
      "--game={input:game}",
      "--update={input:update}"
    ],
    "label": "Unpacking the PKG (when the game is one) and preparing the game image"
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/sixfret.ini",
          "if": "{install}/SixFret.exe"
        },
        {
          "path": "{local}/sixfret/sixfret.ini"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "display_mode",
      "label": "Window",
      "help": "Borderless and fullscreen fill the screen; windowed keeps a normal window.",
      "choices": [
        {
          "label": "Windowed",
          "set": {
            "display_mode": "windowed"
          }
        },
        {
          "label": "Borderless",
          "set": {
            "display_mode": "borderless"
          }
        },
        {
          "label": "Fullscreen",
          "set": {
            "display_mode": "fullscreen"
          }
        }
      ],
      "defaults": {
        "display_mode": "windowed"
      }
    },
    {
      "id": "render_resolution",
      "label": "Render resolution",
      "help": "What the game draws at. Native is the PS4's own 1080p; higher sizes need a stronger graphics card.",
      "choices": [
        {
          "label": "720p",
          "set": {
            "render_resolution": "720p"
          }
        },
        {
          "label": "Native (1080p)",
          "set": {
            "render_resolution": "native"
          }
        },
        {
          "label": "1440p",
          "set": {
            "render_resolution": "1440p"
          }
        },
        {
          "label": "1800p",
          "set": {
            "render_resolution": "1800p"
          }
        },
        {
          "label": "4K",
          "set": {
            "render_resolution": "4K"
          }
        }
      ],
      "defaults": {
        "render_resolution": "native"
      }
    },
    {
      "id": "vsync",
      "label": "VSync",
      "help": "Waits for the display, so there is no tearing.",
      "choices": [
        {
          "label": "On",
          "set": {
            "vsync": "1"
          }
        },
        {
          "label": "Off",
          "set": {
            "vsync": "0"
          }
        }
      ],
      "defaults": {
        "vsync": "1"
      }
    },
    {
      "id": "fps_limit",
      "label": "Frame rate limit",
      "help": "60 is the game's own rate.",
      "choices": [
        {
          "label": "60",
          "set": {
            "fps_limit": "60"
          }
        },
        {
          "label": "30",
          "set": {
            "fps_limit": "30"
          }
        },
        {
          "label": "Unlimited",
          "set": {
            "fps_limit": "0"
          }
        }
      ],
      "defaults": {
        "fps_limit": "60"
      }
    },
    {
      "id": "show_fps",
      "label": "Performance overlay",
      "help": "Shows the frame rate in a corner of the screen.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "show_fps": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "show_fps": "1"
          }
        }
      ],
      "defaults": {
        "show_fps": "0"
      }
    }
  ],
  "saves": [
    "{install}/user/savedata",
    "{install}/user/trophies.dat",
    "{local}/sixfret/user/savedata",
    "{local}/sixfret/user/trophies.dat"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/user/savedata",
        "if": "{install}/SixFret.exe"
      },
      {
        "path": "{local}/sixfret/user/savedata"
      }
    ],
    "logs": [
      {
        "path": "{install}/user",
        "if": "{install}/SixFret.exe"
      },
      {
        "path": "{local}/sixfret/user"
      }
    ]
  },
  "exit_codes": {
    "20": "This processor lacks an instruction set the game needs. The log says which one.",
    "21": "No Guitar Hero Live was found there: pick the dumped game folder (with eboot.bin) or the game's PKG.",
    "22": "That is another game. Six Fret plays Guitar Hero Live for PS4 (CUSA02410).",
    "23": "The dump is incomplete (missing modules, or empty video or tracks folders). Extract the game again.",
    "24": "The PKG could not be unpacked. Only fake-signed PKGs open; check that the file is complete."
  },
  "actions": [
    {
      "id": "saves",
      "label": "Open saves folder",
      "open": "saves"
    }
  ]
}
